{
  "name": "ghostop-studio",
  "version": "1.3.0",
  "description": "GhOstOP Studio with optional runtime AI model download and online location lookup",
  "main": "main.js",
  "author": "GhOstOP",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "model:download": "py -3.13 scripts/download_model.py",
    "build": "electron-builder --win nsis"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.5.0",
    "exifr": "^7.1.3",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.ghostop.studio",
    "productName": "GhOstOP Studio",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "node_modules/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/ghostop.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "asar": true
  }
}
